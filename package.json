{
	"name": "curb-cuts",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint:js": "oxlint --fix",
		"lint": "npm run typecheck && npm run lint:js",
		"format": "dprint fmt",
		"version": "npm version --sign-git-tag --message \"chore: update package version\"",
		"postversion": "changelog --output \"docs/changelog\" --push --create-release",
		"update": "update",
		"certs": "mkcert -install && mkcert -key-file=certs/server.key -cert-file=certs/server.crt localhost",
		"start": "vite",
		"prepreview": "pnpm run build",
		"preview": "vite preview",
		"build": "vite build",
		"generate-icons": "node scripts/generate-icons.ts --svg \"./public/favicon.svg\" --manifest \"./public/site.webmanifest\" --output \"./public\" --ios \"./icons/apple-touch-icon.png\" --favicon"
	},
	"keywords": [],
	"author": "",
	"license": "UNLICENSED",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.4.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^12.4.0",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.18.0",
	"type": "module",
	"devDependencies": {
		"@mad-c/config": "^4.2.1",
		"@types/node": "^26.6.6",
		"dprint": "^0.64.3",
		"icojs": "^1.0.1",
		"open-props": "^1.7.23",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"puppeteer": "^25.17.0",
		"typescript": "^7.0.2",
		"varlock": "^1.24.0",
		"vite": "^8.3.5"
	}
}
